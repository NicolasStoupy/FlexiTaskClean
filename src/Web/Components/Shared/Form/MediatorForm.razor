@typeparam TResponse
@typeparam TRequest where TRequest : MediatR.IRequest<TResponse>
@inject MediatR.IMediator Mediator

<AppForm TModel="TRequest" Model="Model" OnSubmit="SendAsync">
    @Fields(Model)   <!-- NOTE: on force l’usage du slot typé -->
</AppForm>

@code {
    [Parameter] public TRequest Model { get; set; } = default!;
    [Parameter] public RenderFragment<TRequest> Fields { get; set; } = default!;
    [Parameter] public EventCallback<TResponse> OnSuccess { get; set; }

    private async Task SendAsync(TRequest model)
    {
        var result = await Mediator.Send(model);
        await OnSuccess.InvokeAsync(result);
    }
}
