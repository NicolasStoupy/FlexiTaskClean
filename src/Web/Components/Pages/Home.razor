@page "/"
@using Application.Plant.Queries.GetPlants
@using Application.Plant.Commands.UpdatePlant
@inject MediatR.IMediator Mediator
@rendermode InteractiveServer
<h3>Liste des plants</h3>

@if (_vm is null)
{
    <p>Chargement…</p>
}
else
{
    <ul>
        @foreach (var list in _vm.Lists)
        {
            <li>
                @if (_editingPlant?.Id == list.Id)
                {
                    <input @bind="_editingPlant.Code" />
                    <input type="checkbox" @bind="_editingPlant.IsActive" />
                    <button @onclick="() => SaveEditAsync(list)">💾 Sauver</button>
                    <button @onclick="CancelEdit">❌ Annuler</button>
                }
                else
                {
                    @list.Code
                    <input readonly="true" type="checkbox" @bind="list.IsActive" />
                    <button @onclick="() => Edit(list)">✏️ Éditer</button>
                    <button @onclick="() => Delete(list)">✏️ Supprimer</button>
                }
            </li>
        }
    </ul>
}

@code {
    private PlantsVm? _vm;
    private PlantDTO? _editingPlant;

    protected override async Task OnInitializedAsync()
    {
        _vm = await Update();
    }
   

    private async Task<PlantsVm> Update()
    {
        return await Mediator.Send(new GetPlantsQuery());
    }
    private async void Edit(PlantDTO plant)
    {
        _editingPlant = new PlantDTO
        {
            Id = plant.Id,
            Code = plant.Code,
            IsActive= plant.IsActive

        };
        _vm = await Update();
    }
    private async Task Delete(PlantDTO plant)
    {
        await Mediator.Send(new Application.Plant.Commands.DeletePlant.DeletePlantCommand
        {
            Id = plant.Id
        });
        _vm = await Update(); ;

    }
    private async Task SaveEditAsync(PlantDTO plant)
    {
        try
        {
            if (_editingPlant is not null)
            {
                var command = new UpdatePlantCommand()
                {
                    Id = _editingPlant.Id,
                    Code = _editingPlant.Code,
                    IsActive= _editingPlant.IsActive

                };
                var result = await Mediator.Send(command);


              

                _editingPlant = null;
                _vm = await Update();
            }
        }
        catch (Exception ex)
        {

            throw;
        }

    }

    private void CancelEdit() => _editingPlant = null;
}
