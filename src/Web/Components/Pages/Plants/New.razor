@page "/plants/new"
@using Application.Plant.Commands.CreatePlant
@using Web.Components.Shared.Form
@inject NavigationManager Nav
@rendermode InteractiveServer

<MediatorForm TRequest="CreatePlantCommand" TResponse="int"
              Model="_model" OnSuccess="GoToList">
    <Fields Context="m">
        <div class="mb-3">
            <label>Code</label>
            <InputText class="form-control"
                       @bind-Value="m.Code"
                        />

            <ValidationMessage For="@(() => m.Code)" />
        </div>

        <!-- Petit affichage debug : -->
        <div class="text-muted">Valeur courante: @m.Code</div>

        <button class="btn btn-primary">Créer</button>
    </Fields>
</MediatorForm>

@code {
    private CreatePlantCommand _model { get; set; } = new();

    private void GoToList(int id) => Nav.NavigateTo("/");
}
