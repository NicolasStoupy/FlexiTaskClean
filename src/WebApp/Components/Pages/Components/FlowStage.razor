<div class="flow-stage-wrap">
    <div class="flow-stage">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <div class="flow-stage-title">@Title</div>
        }

        <div class="flow-stage-body">
            @ChildContent
        </div>
    </div>

    @if (ShowRightArrow)
    {
        <div class="flow-stage-arrow" aria-hidden="true"></div>
    }
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowRightArrow { get; set; } = true;
}
