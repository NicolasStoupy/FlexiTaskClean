@page "/"
@using Application.Workflows.Queries.GetTaskItem
@using WebApp.Components.Dialogs
@using WebApp.Components.Pages.Components
@using WebApp.Components.Pages.Components.Flow
@using WebApp.Models.Flows
@inject IDialogService DialogService
@rendermode InteractiveServer
<PageTitle></PageTitle>

<h1>@_localizer["Hello World"]</h1>
@DateTime.Now.ToShortDateString()
@DateTime.Now.ToLongDateString()
Welcome to your new app.

<MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ShowDialog">
    Ouvrir le dialogue
</MudButton>
<MudGrid Spacing="2" AlignItems="AlignItems.Center">

    <MudItem xs="12" md="3">
        <FlowNode Title="User" Description="Opens page" />
    </MudItem>

    <MudItem xs="12" md="1" Class="d-none d-md-block">
        <FlowLink Direction="right" />
    </MudItem>

    <MudItem xs="12" md="3">
        <FlowNode Title="Authorize" Description="Admin role?" />
    </MudItem>

    <MudItem xs="12" md="1" Class="d-none d-md-block">
        <FlowLink Direction="right" />
    </MudItem>

    <MudItem xs="12" md="3">
        <FlowNode Title="WorkAreas" Description="List view" />
    </MudItem>

</MudGrid>
<FlowCanvas>

    <FlowStage Title="Input">
        <FlowNode Title="Load Orders" Description="SAP extract" />
        <FlowNode Title="Load Stock" Description="LX02 snapshot" />
        <FlowNode Title="Load Purchases" Description="Inbound" />
    </FlowStage>

    <FlowStage Title="Planning">
        <FlowNode Title="Compute Priorities" Description="Rules engine" />
        <FlowNode Title="Build Task Graph" Description="Dependencies" />
    </FlowStage>

    <FlowStage Title="Execution">
        <FlowNode Title="Assign Tasks" Description="By work area" />
        <FlowNode Title="Scan & Confirm" Description="Operator actions" />
        <FlowNode Title="Close Task" Description="Status update" />
    </FlowStage>

</FlowCanvas>
<FlowCanvas>
    <FlowStage Title="Input" ShowRightArrow="true"> ... </FlowStage>
    <FlowStage Title="Planning" ShowRightArrow="true"> ... </FlowStage>
    <FlowStage Title="Execution" ShowRightArrow="false"> ... </FlowStage>
</FlowCanvas>
@* <FlowGraph Nodes="_nodes" Edges="_edges" /> *@
@code {


    private void ShowDialog()
    {
        var query = new GetTaskItemQuery();
        _Uimediator.Send(query);
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };

        DialogService.Show<SimpleDialog>("Titre du dialogue", options);

    }
    private readonly List<WebApp.Models.Flows.FlowNode> _nodes = new()
    {
      new("A", "Start"),

    new("B", "Prepare Stock"),
    new("C", "Prepare Orders"),
    new("D", "Prepare Purchases"),

    new("E", "Build Task Graph"),   // MERGE de B,C,D

    new("F", "Assign Tasks"),
    new("G", "Quality Check"),

    new("H", "Execute"),            // MERGE de F,G

    new("I", "Close")
    };

    private readonly List<FlowEdge> _edges = new()
    {
      // Fork 1 -> 3
    new("A", "B"),
    new("A", "C"),
    new("A", "D"),

    // Merge 3 -> 1
    new("B", "E"),
    new("C", "E"),
    new("D", "E"),

    // Fork 1 -> 2
    new("E", "F"),
    new("E", "G"),

    // Merge 2 -> 1
    new("F", "H"),
    new("G", "H"),

    // Final
    new("H", "I"),

    };
}