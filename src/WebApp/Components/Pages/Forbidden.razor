@page "/forbidden"
@using MudBlazor



<MudContainer MaxWidth="MaxWidth.Small" Class="mt-12">

    <MudPaper Elevation="4" Class="pa-8 text-center">

        <MudIcon Icon="@Icons.Material.Filled.Block"
                 Color="Color.Error"
                 Size="Size.Large" />

        <MudText Typo="Typo.h4" Class="mt-4">
            @_localizer["FORBIDDEN_TITLE"]
        </MudText>

        <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-2">
            @_localizer["FORBIDDEN_SUBTITLE"]
        </MudText>

        <MudDivider Class="my-4" />

        <MudStack Row Justify="Justify.Center" Spacing="2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Home"
                       OnClick="@(() => Nav.NavigateTo("/"))">
                @_localizer["FORBIDDEN_BTN_HOME"]
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Nav.NavigateTo("/workareas"))">
                @_localizer["FORBIDDEN_BTN_BACK"]
            </MudButton>
        </MudStack>

    </MudPaper>

</MudContainer>
