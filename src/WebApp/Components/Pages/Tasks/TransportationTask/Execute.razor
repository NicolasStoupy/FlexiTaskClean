@page "/tasks/transport/executor/{WorkAreaID:int}"

@using System.Linq
@using System.Collections.Generic
@using Application.Features.TaskExecution
@using Application.Features.Tasks.TransportationTask
@using Domain.Enums
@using System.Threading.Tasks
@using MudBlazor

<MudPaper Class="pa-3" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">My Transport Queue — Area: @_workerArea</MudText>

        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudChip T="string" Variant="Variant.Filled" Color="Color.Info">
                Remaining: @RemainingCount
            </MudChip>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ReloadQueue">
                Reload
            </MudButton>
        </MudStack>
    </MudStack>
</MudPaper>

<div class="transport-executor-page">

    <MudPaper Class="pa-3 transport-top" Elevation="1">
        @if (CurrentTask is null)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No task in queue.
            </MudAlert>
        }
        else
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudStack>
                    <MudText Typo="Typo.h6">
                       @CurrentTask.HumanString — @CurrentTask.StillageId
                    </MudText>
                  
                </MudStack>

               @*  <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.SkipNext"
                           OnClick="SkipCurrent">
                    Skip
                </MudButton> *@
            </MudStack>

            <MudDivider Class="my-3" />

            <div class="transport-stepper">

                <MudStepper @ref="_mudStepper"
                            Linear="true"
                            @bind-ActiveIndex="_step"
                            OnPreviewInteraction="BlockHeaderClick">

                    <ActionContent Context="stepper">
                        <MudStack Row="true" Spacing="2" Justify="Justify.SpaceBetween" Class="mt-4">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Disabled="@(!stepper.PreviousStepEnabled)"
                                       OnClick="stepper.PreviousStepAsync">
                                Retour
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="@PrimaryButtonColor(stepper.ActiveIndex)"
                                       Disabled="@(!CanPrimaryAction(stepper.ActiveIndex))"
                                       OnClick="@(() => PrimaryAction(stepper.ActiveIndex))">
                                @PrimaryButtonText(stepper.ActiveIndex)
                            </MudButton>
                        </MudStack>
                    </ActionContent>

                    <ChildContent>
                        <MudStep Label="Démarrer" Icon="@Icons.Material.Filled.PlayArrow">
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Prendre en charge cette tâche.
                            </MudText>

                            @if (CurrentTask?.Started == true)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                    Started
                                </MudAlert>
                            }
                        </MudStep>

                        <MudStep Label="Mouvement" Icon="@Icons.Material.Filled.SyncAlt">
                            <MudText Typo="Typo.body2">
                                Confirmer le mouvement / localisation SAP.
                            </MudText>

                            <MudGrid Spacing="2" Class="mt-2">
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string"
                                                  Label="Scan Stillage"
                                                  @bind-Value="_confirmStillage"
                                                  Immediate="true" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string"
                                                  Label="Storage Bin"
                                                  @bind-Value="_sapDoc"
                                                  Immediate="true" />
                                </MudItem>
                            </MudGrid>

                            @if (CurrentTask?.MovementDone == true)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                    Movement done
                                </MudAlert>
                            }
                        </MudStep>

                        <MudStep Label="Completed" Icon="@Icons.Material.Filled.CheckCircle">
                            <MudText Typo="Typo.body2">Terminer la tâche.</MudText>

                            @if (CurrentTask?.Completed == true)
                            {
                                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">
                                    Task completed ✅
                                </MudAlert>
                            }
                        </MudStep>
                    </ChildContent>

                </MudStepper>
            </div>
        }
    </MudPaper>

    <MudPaper Class="pa-2 transport-bottom" Elevation="1">
        <MudTable Items="Queue" Dense="true" Hover="true" Bordered="true" FixedHeader="true" >
            <HeaderContent>
                <MudTh style="width:80px;">#</MudTh>
                <MudTh>Stillage</MudTh>
                <MudTh>Instruction</MudTh>
                <MudTh style="width:140px;">Status</MudTh>
            </HeaderContent>

            <RowTemplate>
                @{
                    var t = context;
                    var isCurrent = CurrentTask?.TaskId == t.TaskId;
                }
                <MudTd DataLabel="#">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (isCurrent)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Color="Color.Primary" />
                        }
                        <MudLink Underline="Underline.None"
                                 Style="cursor:pointer"
                                 OnClick="@(() => SelectTask(t.TaskId))">
                            @t.TaskId
                        </MudLink>
                    </MudStack>
                </MudTd>

                <MudTd DataLabel="Stillage">@t.StillageId</MudTd>
                <MudTd DataLabel="Instruction">@t.HumanString</MudTd>

                <MudTd DataLabel="Status">
                    <MudChip T="Color" Size="Size.Small" Color="@GetTaskChipColor(t)" Variant="Variant.Filled">
                        @t.Status
                    </MudChip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

</div>

@code {
    private string _workerArea = "Transportation Area";

    [Parameter]
    public int WorkAreaID { get; set; }

    private MudStepper? _mudStepper;
    private int _step = 0;

    private string _confirmStillage = "";
    private string _sapDoc = "";

    private List<TransportTaskVm> Queue = new();
    private TransportTaskVm? CurrentTask;

    private int RemainingCount => Queue.Count(x => !x.Completed);

    protected override async Task OnInitializedAsync()
    {
        await ReloadQueue();
        SelectFirstIfAny();
    }

    // =========================
    // Stepper buttons (ONLY)
    // =========================
    private string PrimaryButtonText(int stepIndex) => stepIndex switch
    {
        0 => "Démarrer",
        1 => "Confirmer mouvement",
        2 => "Terminer",
        _ => "OK"
    };

    private Color PrimaryButtonColor(int stepIndex) => stepIndex switch
    {
        2 => Color.Success,
        _ => Color.Primary
    };

    private bool CanPrimaryAction(int stepIndex) => stepIndex switch
    {
        0 => CurrentTask is not null && !CurrentTask.Started,
        1 => CanConfirmMovement,
        2 => CanCompleteCurrent,
        _ => false
    };

    private async Task PrimaryAction(int stepIndex)
    {
        if (CurrentTask is null) return;

        switch (stepIndex)
        {
            case 0:
                await StartCurrent();
                break;
            case 1:
                await ConfirmMovement();
                break;
            case 2:
                await CompleteCurrent();
                break;
        }

        // ReloadQueue() -> SyncStepFromState() -> _step aligné
        StateHasChanged();
    }

    // Bloque le clic sur les headers/steps (évite de sauter des étapes)
    private Task BlockHeaderClick(StepperInteractionEventArgs args)
    {
        // on annule toute interaction venant du header (click step label)
        // On laisse les boutons ActionContent piloter le flow
        args.Cancel = true;
        return Task.CompletedTask;
    }

    // =========================
    // Queue / Selection
    // =========================
    private async Task ReloadQueue()
    {
        Queue = await LoadQueue(WorkAreaID);
        CurrentTask = PickCurrentTaskAfterReload();

        SyncStepFromState();
        ResetInputsForCurrent();
    }

    private void SelectFirstIfAny()
    {
        CurrentTask ??= Queue.FirstOrDefault(x => !x.Completed);
        SyncStepFromState();
        ResetInputsForCurrent();
    }

    private void SelectTask(int taskId)
    {
        var t = Queue.FirstOrDefault(x => x.TaskId == taskId);
        if (t is null) return;

        CurrentTask = t;
        SyncStepFromState();
        ResetInputsForCurrent();
    }

    private TransportTaskVm? PickCurrentTaskAfterReload()
    {
        if (Queue.Count == 0) return null;

        if (CurrentTask is not null)
        {
            var same = Queue.FirstOrDefault(x => x.TaskId == CurrentTask.TaskId);
            if (same is not null && !same.Completed && same.Status != "Skipped")
                return same;
        }

        return Queue.FirstOrDefault(x => !x.Completed && x.Status != "Skipped");
    }

    private void SyncStepFromState()
    {
        if (CurrentTask is null) { _step = 0; return; }
        if (!CurrentTask.Started) { _step = 0; return; }
        if (!CurrentTask.MovementDone) { _step = 1; return; }
        _step = 2;
    }

    private void ResetInputsForCurrent()
    {
        if (CurrentTask is null) return;
        _confirmStillage = CurrentTask.StillageId;
        _sapDoc = CurrentTask.SapDoc ?? "";
    }

    // =========================
    // Actions métier
    // =========================
    private async Task StartCurrent()
    {
        if (CurrentTask is null) return;

        var resultCmd = await _Uimediator.Send(new TaskHandleTransitionCommand(CurrentTask.TaskId));
        if (resultCmd.success)
        {
            CurrentTask.Started = true;
            SyncStepFromState();
        }

        await ReloadQueue();
    }

    private bool CanConfirmMovement =>
        CurrentTask is not null &&
        CurrentTask.Started &&
        !CurrentTask.MovementDone &&
        string.Equals((_confirmStillage ?? "").Trim(), CurrentTask.StillageId, StringComparison.OrdinalIgnoreCase);

    private async Task ConfirmMovement()
    {
        if (CurrentTask is null) return;
        if (!CanConfirmMovement) return;

        var resultCmd = await _Uimediator.Send(new TaskHandleTransitionCommand(CurrentTask.TaskId));
        if (resultCmd.success)
        {
            CurrentTask.MovementDone = true;
            CurrentTask.SapDoc = _sapDoc;
            SyncStepFromState();
        }

        await ReloadQueue();
    }

    private bool CanCompleteCurrent =>
        CurrentTask is not null &&
        CurrentTask.Started &&
        CurrentTask.MovementDone &&
        !CurrentTask.Completed;

    private async Task CompleteCurrent()
    {
        if (CurrentTask is null) return;
        if (!CanCompleteCurrent) return;

        var resultCmd = await _Uimediator.Send(new TaskHandleTransitionCommand(CurrentTask.TaskId));
        if (resultCmd.success)
        {
            CurrentTask.Completed = true;
            CurrentTask.Status = "Completed";
        }

        await ReloadQueue();
    }

    private void SkipCurrent()
    {
        if (CurrentTask is null) return;

        CurrentTask.Status = "Skipped";
        CurrentTask = Queue.FirstOrDefault(x => !x.Completed && x.Status != "Skipped");
        SyncStepFromState();
        ResetInputsForCurrent();
    }

    private Color GetTaskChipColor(TransportTaskVm t)
    {
        if (t.Completed) return Color.Success;
        if (t.MovementDone) return Color.Info;
        if (t.Started) return Color.Warning;
        if (t.Status == "Skipped") return Color.Error;
        return Color.Default;
    }

    // =========================
    // VM + Load
    // =========================
    public class TransportTaskVm
    {
        public int TaskId { get; set; }
        public string FromArea { get; set; } = "";
        public string ToArea { get; set; } = "";
        public string StillageId { get; set; } = "";

        public bool Started { get; set; }
        public bool MovementDone { get; set; }
        public bool Completed { get; set; }

        public string Status { get; set; } = "Ready";
        public string? SapDoc { get; set; }
        public string HumanString { get; set; } = "";
    }

    private async Task<List<TransportTaskVm>> LoadQueue(int workAreaID)
    {
        var result = await _Uimediator.Send(new GetTransportQueueQuery(workAreaID));

        if (!result.success || result.Data is null)
            return new List<TransportTaskVm>();

        return result.Data.Select(q => new TransportTaskVm
        {
            TaskId = q.TaskID,
            FromArea = q.FromArea,
            ToArea = q.ToArea,
            StillageId = q.Support,
            HumanString = q.HumanInstruction,
            Status = q.TaskItemStatus.ToString(),

            Started = q.TaskItemStatus == TaskItemStatus.InProgress
                   || q.TaskItemStatus == TaskItemStatus.Completed,

            MovementDone = q.TaskItemStatus == TaskItemStatus.Completed,
            Completed = q.TaskItemStatus == TaskItemStatus.Completed
        }).ToList();
    }
   
}
