@page "/tasks/list/{AreaId:int}"
@using System.Threading.Tasks
@using Application.Features.TaskExecution
@using Application.Features.Tasks.TaskList
@using Domain.Enums



<MudPaper Elevation="2" Class="pa-2 mb-6" Style="position: sticky; top: 70px; z-index: 10;">
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h6" Class="ml-2 mr-4">Actions</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="@($"/tasks/emptystillage/new")"
                   StartIcon="@Icons.Material.Filled.AddCircle">
            Besoin chevalet vide
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Href="@($"/tasks/transportation/create/{AreaId}")"
                   StartIcon="@Icons.Material.Filled.LocalShipping">
            Créer un transport
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   Href="@($"/tasks/transport/executor/{AreaId}")"
                   StartIcon="@Icons.Material.Filled.PlaylistPlay">
            Execute transport queue
        </MudButton>
        <MudSpacer />


    </MudStack>
</MudPaper>
<h3>Tâches dans Area : @AreaId</h3>

<MudTable Items="_vm.Tasks"
          Hover="true" Bordered="true" Striped="true" Dense="true">

    <HeaderContent>
        <MudTh>Task Type</MudTh>
        <MudTh>Task ID</MudTh>
        <MudTh>TargetDate</MudTh>
        <MudTh>TaskItemType</MudTh>
        <MudTh>TaskData</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>
            @if (context is TransportationTaskListItemDto tr)
            {
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Color="Color.Info" />

            }
            else if (context is LoadingTaskListItemDto lo)
            {
                <MudIcon Icon="@Icons.Material.Filled.MoveToInbox" Color="Color.Warning" />
            }
        </MudTd>
        <MudTd DataLabel="Task ID">@context.TaskItemID</MudTd>
        <MudTd DataLabel="Task ID">@context.TargetDate</MudTd>
        <MudTd DataLabel="TaskType">@context.TaskItemType</MudTd>
        <MudTd>
            @if (context is TransportationTaskListItemDto tr)
            {
                <MudStack Spacing="0">
                    <!-- Ligne principale -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">

                        <MudText Typo="Typo.body1" Class="fw-600">
                            @tr.SourceAreaName → @tr.DestinationAreaName
                        </MudText>

                        <MudSpacer />

                        @if (!string.IsNullOrWhiteSpace(tr.Support))
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="Variant.Filled"
                                     Color="Color.Info">
                                @tr.Support
                            </MudChip>
                        }
                    </MudStack>

                </MudStack>
            }
            else if (context is LoadingTaskListItemDto lo)
            {
                <MudStack Spacing="0">
                    <!-- Ligne principale -->
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1" Class="fw-600">
                            @lo.Quantity x @lo.Material
                        </MudText>

                        <MudSpacer />

                        <MudChip T="string"
                                 Size="Size.Small"
                                 Variant="Variant.Filled"
                                 Color="Color.Primary">
                            @lo.AreaForLoadingName
                        </MudChip>
                    </MudStack>

                </MudStack>
            }
        </MudTd>


        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small"
                     Variant="Variant.Filled"
                     Color="@GetStatusColor(context.TaskItemStatus)">
                @context.TaskItemStatus
            </MudChip>
        </MudTd>

        <MudTd DataLabel="Actions">
            <MudStack Row="true" Spacing="1">

                <MudButton OnClick="@(() => Take(context.TaskItemID))"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PlayArrow">
                    Prendre
                </MudButton>

                <MudButton OnClick="@(() => Take(context.TaskItemID))"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Info">
                    Détails
                </MudButton>

            </MudStack>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter]
    public int AreaId { get; set; }

    public TaskListVm _vm = new TaskListVm();
    protected override async Task OnInitializedAsync()
    {
        await Update();

    }

    public async Task Update()
    {
        var query = new GetTaskListQuery(AreaId, Domain.Enums.TaskItemStatus.NotStarted);
        var queryResult = await _Uimediator.Send(query);

        if (queryResult.success)
        {
            _vm = queryResult.Data;
        }
    }
    public async Task Take(int taskId) { await _Uimediator.Send(new TaskHandleTransitionCommand(taskId)); await Update(); }

    private Color GetStatusColor(string status) => status switch
    {
        "InProgress" => Color.Warning,
        "Ready" => Color.Info,
        "Completed" => Color.Success,
        "" => Color.Default
    };
}
