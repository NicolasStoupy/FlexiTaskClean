@page "/tasks/emptystillage/new/{DestinationWorkAreaID:int}"

@using System.ComponentModel.DataAnnotations
@using Application.Common.Dtos.Lookups
@using Application.Features.Tasks.EmptySupport
@inject ISnackbar _snackbar
<h3>Need an empty stillage</h3>

<MudPaper Class="pa-3" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">Task creation</MudText>

        <MudChip T="string" Color="@HeaderColor" Variant="Variant.Filled">
            @HeaderStatus
        </MudChip>
    </MudStack>
</MudPaper>

<MudPaper Class="pa-3 mt-3" Elevation="1">
    <MudStepper Linear="true" OnPreviewInteraction="ControlStepNavigation" ShowSkip="false" ShowResetButton="false" @bind-ActiveIndex="_step">
        <!-- STEP 1 -->
        <MudStep Label="Define a type of stillage" Icon="@Icons.Material.Filled.Category">
            <MudText Typo="Typo.body2" Class="mb-2">
                Choose the stillage type you need.
            </MudText>
            <MudSelect T="string"
                       @bind-Value="@RequestModel.StillageType"
                       Label="Stillage type"
                       Dense="true"
                       Required="true">
                @foreach (var t in Model.supportTypes)
                {
                    <MudSelectItem T="string" Value="@t.SupportTypeID"> @t.SupportTypeID || @t.Description</MudSelectItem>
                }
            </MudSelect>
            <MudDivider Class="my-3" />
        </MudStep>

        <!-- STEP 2 -->
        <MudStep Label="Define the qty" Icon="@Icons.Material.Filled.Numbers">
            <MudText Typo="Typo.body2">
                Enter the number of empty stillages needed.
            </MudText>

            <MudNumericField T="int"
                             Label="Quantity"
                             Dense="true"
                             Min="1"
                             Max="50"
                             Immediate="true"
                             @bind-Value="RequestModel.Quantity"
                             Class="mt-2" />

            <MudTextField T="string"
                          Label="Comment (optional)"
                          Dense="true"
                          Immediate="true"
                          @bind-Value="RequestModel.Comment"
                          Class="mt-2" />

            <MudDivider Class="my-3" />
        </MudStep>

        <!-- STEP 3 -->
        <MudStep Label="Validate the task creation" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
            <MudText Typo="Typo.body2" Class="mb-2">
                Review and validate the request.
            </MudText>

            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                <MudGrid Spacing="2">
                   
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption">Stillage type</MudText>
                        <MudText Typo="Typo.body1">@RequestModel.StillageType</MudText>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudText Typo="Typo.caption">Quantity</MudText>
                        <MudText Typo="Typo.body1">@RequestModel.Quantity</MudText>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption">Comment</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(RequestModel.Comment) ? "-" : RequestModel.Comment)
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (_created)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="mt-3">
                    Empty stillage task validated ✅ (created)
                </MudAlert>
            }
        </MudStep>
    </MudStepper>
</MudPaper>

@code {


    [Parameter]
    public int DestinationWorkAreaID { get; set; }
    // ===== Step state =====
    private int _step = 0;
    private bool _created = false;

    // ===== ViewModel =====
    public class EmptyStillageRequestVm
    {
        [Required] public string StillageType { get; set; } = "";
        [Range(1, 50)] public int Quantity { get; set; } = 1;
        public string? Comment { get; set; }
    }
    private EmptySupportVm Model = new();

    private EmptyStillageRequestVm RequestModel = new();

    protected override async Task OnInitializedAsync()
    {
        var requestResult = await _Uimediator.Send(new GetEmptySupportQuery(DestinationWorkAreaID));
        if (requestResult.success && requestResult.Data != null)
        {
            Model = requestResult.Data;
        }
    }

    // ===== UI helpers =====
    private bool IsStep1Valid => !string.IsNullOrWhiteSpace(RequestModel.StillageType);

    private bool IsStep2Valid => RequestModel.Quantity >= 1;

    private bool CanCreate => IsStep1Valid && IsStep2Valid && !_created;

    private string HeaderStatus =>
        _created ? "Validated" :
        _step == 0 ? "Choose type" :
        _step == 1 ? "Set qty" :
        "Review";

    private Color HeaderColor =>
        _created ? Color.Success :
        _step == 0 ? Color.Info :
        _step == 1 ? Color.Warning :
        Color.Primary;

    private void Next()
    {
        if (_step < 2) _step++;
    }
    private async Task ControlStepNavigation(StepperInteractionEventArgs arg)
    {
        var stepIndex = arg.StepIndex;
        if (stepIndex == 0 && !IsStep1Valid)
        {
            _snackbar.Add("Choississez une type de chevalet", Severity.Error);
            arg.Cancel = true;
        }
        if (stepIndex == 1 && !IsStep2Valid)
        {
            _snackbar.Add("Une quantité a 0 doit être entrée", Severity.Error);
            arg.Cancel = true;
        }
        if (stepIndex == 2)
        {
            await CreateTask();
        }


    }
    private void Prev()
    {
        if (_step > 0) _step--;
    }

    private async Task CreateTask()
    {
        if (!CanCreate) return;

        var request = new RequestEmptySupportCommand(RequestModel.StillageType, RequestModel.Quantity, RequestModel.Comment, DestinationWorkAreaID);

        var requestResult = await _Uimediator.Send(request);
        if (requestResult.success)
        {
            _created = true;
            History.GoBack();
        }
      
             
    }
}
