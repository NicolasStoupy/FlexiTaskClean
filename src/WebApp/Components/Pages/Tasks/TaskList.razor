@page "/tasks/list/{AreaId:int}"
@using System.Threading.Tasks
@using Application.Features.GetTaskList
@using Application.Features.TaskExecution



<MudPaper Elevation="2" Class="pa-2 mb-6" Style="position: sticky; top: 70px; z-index: 10;">
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">

        <MudText Typo="Typo.h6" Class="ml-2 mr-4">Actions</MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddCircle">
            Besoin
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.LocalShipping">
            Transport
        </MudButton>



        <MudSpacer />


    </MudStack>
</MudPaper>
<h3>En Attente de Transit</h3>

<MudTable Items="_vm.Tasks"
          Hover="true" Bordered="true" Striped="true" Dense="true">

    <HeaderContent>
        <MudTh>Task ID</MudTh>
        <MudTh>TargetDate</MudTh>
        <MudTh>TaskItemType</MudTh>
        <MudTh>TaskData</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Task ID">@context.TaskItemID</MudTd>
        <MudTd DataLabel="Task ID">@context.TargetDate</MudTd>
        <MudTd DataLabel="TaskType">@context.TaskItemType</MudTd>
        <MudTd>
            @if (context is TransportationTaskListItemDto tr)
            {
                <label>
                    @tr.SourceAreaName => @tr.DestinationAreaName ( @tr.Support)
                </label>
                
                
            
            }
            @if(context is LoadingTaskListItemDto lo)
            {
                <label>@lo.Quantity x  @lo.Material in @lo.AreaForLoadingName </label>
                
               
            }

        </MudTd>


        <MudTd DataLabel="Status">@context.TaskItemStatus</MudTd>

        <MudTd DataLabel="Actions">
            <MudButton OnClick="@(() => Take(context.TaskItemID))"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small">
                Prendre
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small">
                Détails
            </MudButton>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter]
    public int AreaId { get; set; }

    public TaskListVm _vm = new TaskListVm();
    protected override async Task OnInitializedAsync()
    {
        await Update();

    }

    public async Task Update()
    {
        var query = new GetTaskListQuery(AreaId, Domain.Enums.TaskItemStatus.NotStarted);
        var queryResult = await _Uimediator.Send(query);

        if (queryResult.success)
        {
            _vm = queryResult.Data;
        }
    }
    public async Task Take(int taskId) { await _Uimediator.Send(new TaskHandleTransitionCommand(taskId)); await Update(); }
}
