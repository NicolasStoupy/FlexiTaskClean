@using WebApp.Services
@using WebApp.Themes
@inject ThemeService ThemeService

@rendermode InteractiveServer

@* Required *@
<MudThemeProvider Theme="_themeDefinition" IsDarkMode="ThemeService.IsDarkMode" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

@code{
   
    private MudTheme _themeDefinition = CustomMudTheme.AgcTheme;
    protected override void OnInitialized() => ThemeService.OnChange += StateHasChanged;
    public void Dispose() => ThemeService.OnChange -= StateHasChanged;

}