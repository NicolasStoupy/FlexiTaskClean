@using Microsoft.AspNetCore.Localization
@using System.Globalization
@inject NavigationManager Nav
@inject IConfiguration Configuration
@rendermode InteractiveServer

@if (cultures != null)
{
    <MudMenu Dense="true" Class="d-none d-sm-flex"
              AnchorOrigin="Origin.BottomCenter"
              TransformOrigin="Origin.TopCenter"
              OffsetY="true">

        <ActivatorContent>
            <MudIconButton Size="Size.Small"
                           Variant="Variant.Text"
                           Class="lang-btn">
                <MudImage Src="@GetFlagUrl(selectedCulture)"
                          Class="lang-flag-mini"
                          Alt="Language" />
            </MudIconButton>
        </ActivatorContent>

        <ChildContent>
            @foreach (var culture in cultures!)
            {
                <MudMenuItem OnClick="@(() => OnCultureChanged(culture.Key))">
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="1">
                        <MudImage Src="@GetFlagUrl(culture.Key)"
                                  Class="lang-flag-mini" />
                        <MudText Typo="Typo.body2">@culture.Value</MudText>
                    </MudStack>
                </MudMenuItem>
            }
        </ChildContent>

    </MudMenu>


    
}

