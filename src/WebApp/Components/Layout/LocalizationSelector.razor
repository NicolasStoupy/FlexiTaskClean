@using Microsoft.AspNetCore.Localization
@using System.Globalization
@inject NavigationManager Nav
@inject IConfiguration Configuration
@rendermode InteractiveServer

@if (cultures != null)
{
    <MudSelect T="string"
               Value="selectedCulture"
               ValueChanged="OnCultureChanged"
               Label="Language"
               Variant="Variant.Outlined"
               Dense="true"
               Margin="Margin.Dense"
               Class="mud-width-full max-w-200"
               AnchorOrigin="Origin.BottomCenter">

        @foreach (var culture in cultures)
        {
            <MudSelectItem Value="@culture.Key">
                <div class="d-flex align-center">
                    <MudImage Src="@GetFlagUrl(culture.Key)"
                              Alt="@culture.Value"
                              Class="mr-2"
                              Style="width:20px; height:15px; object-fit:cover; border-radius:2px;" />
                    <MudText>@culture.Value</MudText>
                </div>
            </MudSelectItem>
        }
    </MudSelect>
}

