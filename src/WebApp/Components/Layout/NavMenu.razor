@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using WebApp.Services
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@rendermode InteractiveServer

<MudNavMenu Class="mud-width-full">
    <MudText Typo="Typo.h6" Class="px-4 py-2">@_localizer["NAV_MENU_TITLE"]</MudText>
    <MudDivider Class="my-2" />

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">@_localizer["NAV_HOME"]</MudNavLink>
    <MudNavLink Href="counter" Icon="@Icons.Material.Filled.Add">@_localizer["NAV_COUNTER"]</MudNavLink>

    <MudNavGroup Title="@_localizer["NAV_GROUP_OU"]" Icon="@Icons.Material.Filled.Layers">
        <MudNavLink Href="plants" Icon="@Icons.Material.Filled.Factory">@_localizer["NAV_PLANTS"]</MudNavLink>
        <MudNavLink Href="workareas" Icon="@Icons.Material.Filled.Work" IconColor="Color.Primary">@_localizer["NAV_WORKAREAS"]</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="@_localizer["NAV_GROUP_SETTINGS"]" Icon="@Icons.Material.Filled.Settings">
        <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People" IconColor="Color.Success">@_localizer["NAV_USERS"]</MudNavLink>
        <MudNavLink Href="/security" Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">@_localizer["NAV_SECURITY"]</MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="Account/Logout" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                @_localizer["NAV_LOGOUT"]
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Register" Icon="@Icons.Material.Filled.AppRegistration">@_localizer["NAV_REGISTER"]</MudNavLink>
            <MudNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login">@_localizer["NAV_LOGIN"]</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>

    <MudSwitch T="bool"
               Value="ThemeService.IsDarkMode"
               ValueChanged="@(_ => ThemeService.ToggleDarkMode())"
               Color="Color.Info"
               Class="ml-4">
        @(ThemeService.IsDarkMode? _localizer["THEME_DARK"] : _localizer["THEME_LIGHT"])
    </MudSwitch>
</MudNavMenu>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}