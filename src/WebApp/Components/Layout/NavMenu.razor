@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using WebApp.Services
@implements IDisposable
@inject NavigationManager NavigationManager
@inject ThemeService ThemeService
@rendermode InteractiveServer

<MudNavMenu Class="mud-width-full">
    <MudText Typo="Typo.h6" Class="px-4 py-2">Menu</MudText>
    <MudDivider Class="my-2" />

    @* Liens Publics *@
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="counter" Icon="@Icons.Material.Filled.Add">@_localizer["Nav_Counter"]</MudNavLink>
    <MudNavLink Href="weather" Icon="@Icons.Material.Filled.Cloud">Weather</MudNavLink>
    <MudNavLink Href="auth" Icon="@Icons.Material.Filled.Lock">Auth Required</MudNavLink>

    @* Groupe extensible (Settings) *@
    <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings">
        <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People" IconColor="Color.Success">Users</MudNavLink>
        <MudNavLink Href="/security" Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">Security</MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-2" />

    @* Liens d'Authentification *@
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="Account/Manage" Icon="@Icons.Material.Filled.Person">
                @context.User.Identity?.Name
            </MudNavLink>
            @* Logout utilise souvent un formulaire ou une redirection directe vers le endpoint *@
            <MudNavLink Href="Account/Logout" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                Logout
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="Account/Register" Icon="@Icons.Material.Filled.AppRegistration">Register</MudNavLink>
            <MudNavLink Href="Account/Login" Icon="@Icons.Material.Filled.Login">Login</MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
    <LocalizationSelector></LocalizationSelector>
    <MudSwitch T="bool"
               Value="ThemeService.IsDarkMode"
               ValueChanged="@(_ => ThemeService.ToggleDarkMode())"
               Color="Color.Info"
               ThumbIcon="@(ThemeService.IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.WbSunny)"
               ThumbIconColor="@(ThemeService.IsDarkMode ? Color.Info : Color.Warning)"
               Class="ml-4">
        @(ThemeService.IsDarkMode ? "Mode Sombre" : "Mode Clair")
    </MudSwitch>
</MudNavMenu>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}